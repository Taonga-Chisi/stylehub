# ==========================================
# Root .gitignore for STYLEHUB
# ==========================================

# Virtual Environments (Backend)
backend/stylehub_backend/
stylehub_backend/
venv/
.venv/
env/
ENV/

# Python / Django
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
db.sqlite3
db.sqlite3-journal
backend/media/
backend/staticfiles/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vercel/
node_modules/
dist/
.vercel/

# Environment Variables
.env
.env.local
.env.*.local
*.env
!.env.example
frontend/.env
frontend/.env.local
frontend/.env.*.local
backend/.env

# Editor & OS files
.vscode/
.idea/
.DS_Store
*.swp
*.swo
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
