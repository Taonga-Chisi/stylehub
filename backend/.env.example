SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=False
ALLOWED_HOSTS=your-backend-host.example
CORS_ALLOWED_ORIGINS=https://your-stylehub-site.vercel.app,http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Optional: configure these to email salon owners when their listing is approved.
# In-app approval notices are stored even when SMTP is not configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=StyleHub <no-reply@your-domain.example>
